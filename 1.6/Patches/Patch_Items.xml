<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Allow traders to SELL Nuclear Battery -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_NuclearBattery"]/tradeability</xpath>
		<value>
			<tradeability>All</tradeability>
		</value>
	</Operation>

	<!-- Nuclear Battery on DMS faction BASE trader -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/TraderKindDef[defName="DMS_Base_Army_Standard"]/stockGenerators</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/TraderKindDef[defName="DMS_Base_Army_Standard"]/stockGenerators</xpath>
			<value>
				<li Class="StockGenerator_SingleDef">
					<thingDef>DMS_NuclearBattery</thingDef>
					<countRange>1~2</countRange>
				</li>
			</value>
		</match>
	</Operation>

    <!-- DMS Tribute collector no longer buys slaves/prisoners -->
	<Operation Class="PatchOperationConditional">
	    <xpath>Defs/StatDef[defName="RoyalFavorValue"]</xpath>
	    <match Class="PatchOperationRemove">
	      <xpath>Defs/TraderKindDef[defName="DMS_Caravan_TributeCollector"]/stockGenerators/li[@Class="StockGenerator_BuySlaves"]</xpath>
	    </match>
	</Operation>


</Patch>