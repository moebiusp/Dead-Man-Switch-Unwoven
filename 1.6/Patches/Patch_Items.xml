<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Allow traders to SELL this item -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_NuclearBattery"]/tradeability</xpath>
		<value>
			<tradeability>All</tradeability>
		</value>
	</Operation>

	<!-- Nuclear Battery on DMS faction BASE trader -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/TraderKindDef[defName="DMS_Base_Army_Standard"]/stockGenerators</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/TraderKindDef[defName="DMS_Base_Army_Standard"]/stockGenerators</xpath>
			<value>
				<li Class="StockGenerator_SingleDef">
					<!-- MUST be the exact ThingDef defName that exists -->
					<thingDef>DMS_NuclearBattery</thingDef>
					<countRange>1~2</countRange>
				</li>
			</value>
		</match>
	</Operation>

</Patch>