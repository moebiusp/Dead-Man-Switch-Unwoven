<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Allow traders to SELL Nuclear Battery -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_NuclearBattery"]/tradeability</xpath>
		<value>
			<tradeability>All</tradeability>
		</value>
	</Operation>

	<!-- Nuclear Battery on DMS faction BASE trader -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/TraderKindDef[defName="DMS_Base_Army_Standard"]/stockGenerators</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/TraderKindDef[defName="DMS_Base_Army_Standard"]/stockGenerators</xpath>
			<value>
				<li Class="StockGenerator_SingleDef">
					<thingDef>DMS_NuclearBattery</thingDef>
					<countRange>1~2</countRange>
				</li>
			</value>
		</match>
	</Operation>

    <!-- DMS Tribute collector no longer buys slaves/prisoners -->
	<Operation Class="PatchOperationConditional">
	    <xpath>Defs/StatDef[defName="RoyalFavorValue"]</xpath>
	    <match Class="PatchOperationRemove">
	      <xpath>Defs/TraderKindDef[defName="DMS_Caravan_TributeCollector"]/stockGenerators/li[@Class="StockGenerator_BuySlaves"]</xpath>
	    </match>
	</Operation>

	<!-- Replace the awful and of bad taste gene for something more useful and sensible -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="DMS_Wetware"]</xpath>
			<value>
			  <GeneDef>
			    <defName>DMS_Wetware</defName>
			    <label>wetware interface</label>
			    <labelShortAdj>wetware</labelShortAdj>
			    <description>
				Neural tissue has reorganized into dense wetware optimized for computation and machine interfacing.
				Boosts mental output and mechanitor capacity.
			    </description>

			    <!-- Intentionally removed to eliminate the original custom behavior -->
			    <!-- <geneClass>DMS.Gene_Wetware</geneClass> -->

			    <iconPath>UI/Gene/Gene_Wetware</iconPath>
			    <displayOrderInCategory>80</displayOrderInCategory>

			    <biostatMet>-3</biostatMet>

			    <statFactors>
			      <ResearchSpeed>1.20</ResearchSpeed>
			      <GlobalLearningFactor>1.10</GlobalLearningFactor>
			      <RestFallRateFactor>0.90</RestFallRateFactor>
			    </statFactors>

			    <statOffsets>
			      <MechBandwidth>6</MechBandwidth>
			      <MechControlGroups>1</MechControlGroups>
			    </statOffsets>

			  </GeneDef>
			</value>
	</Operation>

</Patch>