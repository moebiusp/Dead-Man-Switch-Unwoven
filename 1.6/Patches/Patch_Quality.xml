<?xml version="1.0" encoding="utf-8"?>
<Patch>

<!-- DMS melee weapons inherit from BaseMeleeWeapon_Sharp_Quality (quality via parent) -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[(defName="DMS_StunBaton" or defName="DMS_Machete") and @ParentName="BaseMeleeWeapon_Sharp_Quality"]</xpath>
		<match Class="PatchOperationAttributeSet">
			<xpath>Defs/ThingDef[defName="DMS_StunBaton" or defName="DMS_Machete"]</xpath>
			<attribute>ParentName</attribute>
			<value>BaseMeleeWeapon_Sharp</value>
		</match>
	</Operation>

<!-- Force all DMS_Armor-tagged apparel to inherit from a no-quality base -->
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]</xpath>
		<attribute>ParentName</attribute>
		<value>ApparelNoQualityBase</value>
	</Operation>

	<!-- Remove CompQuality only when present -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[compClass="CompQuality"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[compClass="CompQuality"]</xpath>
		</match>
	</Operation>

	<!-- Remove CompProperties_Quality only when present -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[@Class="CompProperties_Quality"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[@Class="CompProperties_Quality"]</xpath>
		</match>
	</Operation>

</Patch>