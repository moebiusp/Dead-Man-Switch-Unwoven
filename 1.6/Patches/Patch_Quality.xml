<texPath>Things/Weapons/DMS_StunBaton</texPath>

<graphicClass>Graphic_Single</graphicClass>

</graphicData>

<techLevel>Industrial</techLevel>

<weaponTags>

<li>A_RC</li>

<li>A_RC_Melee</li>

<li>DMS_MeleeWeapon</li>

</weaponTags>

<statBases>

<WorkToMake>25000</WorkToMake>

<Mass>2</Mass>

</statBases>

<equippedAngleOffset>-65</equippedAngleOffset>

<tools>

<li>

<label>handle</label>

<capacities>

<li>Blunt</li>

</capacities>

<power>5</power>

<cooldownTime>1.5</cooldownTime>

<extraMeleeDamages>

<li>

<def>Stun</def>

<amount>5</amount>

</li>

</extraMeleeDamages>

</li>

<li>

<label>point</label>

<capacities>

<li>Blunt</li>

</capacities>

<power>10</power>

<cooldownTime>2.2</cooldownTime>

<extraMeleeDamages>

<li>

<def>EMP</def>

<amount>18</amount>

</li>

<li>

<def>Burn</def>

<amount>5</amount>

</li>

<li>

<def>Stun</def>

<amount>4</amount>

</li>

</extraMeleeDamages>

</li>

<li>

<label>edge</label>

<capacities>

<li>Blunt</li>

</capacities>

<power>8</power>

<cooldownTime>2</cooldownTime>

<extraMeleeDamages>

<li>

<def>EMP</def>

<amount>18</amount>

</li>

<li>

<def>Stun</def>

<amount>6</amount>

</li>

</extraMeleeDamages>

</li>

</tools>

<costList>

<Polyester>20</Polyester>

