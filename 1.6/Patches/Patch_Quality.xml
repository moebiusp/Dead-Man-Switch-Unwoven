</researchPrerequisites>

<skillRequirements>

<Crafting>4</Crafting>

</skillRequirements>

</recipeMaker>

</ThingDef>

</value>

</Operation>

<Operation Class="PatchOperationReplace">

<xpath>Defs/ThingDef[defName="DMS_Machete"]</xpath>

<value>

<ThingDef ParentName="BaseMeleeWeapon_Sharp">

<defName>DMS_Machete</defName>

