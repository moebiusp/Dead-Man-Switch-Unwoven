</Operation>


<!--
    Remove quality ONLY from DMS armor (exclude all DMS_Clothing items).
    This keeps quality on uniforms/coats/cloaks/etc that are tagged DMS_Clothing.
-->
	<!-- Remove quality by forcing DMS_Armor to inherit from a no-quality apparel base -->
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]</xpath>
		<attribute>ParentName</attribute>
		<value>ApparelNoQualityBase</value>
	</Operation>

	<!-- Only remove CompQuality when it actually exists (prevents "PatchOperationRemove ... failed") -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[compClass="CompQuality"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[compClass="CompQuality"]</xpath>
		</match>
	</Operation>

	<!-- Only remove CompProperties_Quality when it actually exists -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[@Class="CompProperties_Quality"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[tradeTags/li="DMS_Armor"]/comps/li[@Class="CompProperties_Quality"]</xpath>
		</match>
	</Operation>


</Patch>