<?xml version="1.0" encoding="utf-8"?>

<Patch>

<!-- A) Remove CompQuality from any DMS ThingDef that defines it directly -->

<Operation Class="PatchOperationRemove">

<xpath>Defs/ThingDef[starts-with(defName, "DMS_")]/comps/li[compClass="CompQuality"]</xpath>

</Operation>

<!-- B) DMS melee weapons inherit from BaseMeleeWeapon_Sharp_Quality (quality via parent),

so we re-define them with a non-quality parent. -->

<Operation Class="PatchOperationReplace">

<xpath>Defs/ThingDef[defName="DMS_StunBaton"]</xpath>

<value>

<ThingDef ParentName="BaseMeleeWeapon_Sharp">

<defName>DMS_StunBaton</defName>

